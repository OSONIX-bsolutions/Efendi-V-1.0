# ==============================================================================
# Application Runtime (Vercel / Node.js)
# ==============================================================================
NODE_ENV="production"
# Local dev uses 3000; container deployments inject PORT (e.g. 8080)
PORT="3000"
APP_URL="https://your-app.vercel.app"
# Comma-separated allowed CORS origins (Vercel automatically allows VERCEL_URL)
ALLOWED_ORIGINS="https://your-app.vercel.app"

# ==============================================================================
# Supabase Configuration (Client Publishable + Server Secret)
# ==============================================================================
# Frontend publishable variables (set in Vercel Environment Variables for Build + Runtime)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-publishable-or-anon-key"

# Server-side Supabase variables (set in Vercel Environment Variables)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-supabase-publishable-or-anon-key"
# CRITICAL: Server-only secret key (NEVER prefix with VITE_ or expose to browser)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-secret-or-service-role-key"

# ==============================================================================
# Server Security & Role Bootstrap
# ==============================================================================
# High-entropy random string (e.g. openssl rand -hex 32)
ORDER_TRACKING_SECRET="replace-with-strong-random-hmac-secret"

# Optional comma-separated email allowlists for initial bootstrap/fallback roles
DEVELOPER_EMAILS=""
ADMIN_EMAILS=""
STAFF_EMAILS=""
